/home/pzserver/Zomboid/Server/pzserver.ini

DESCRIPTION  PORT   PROTOCOL  LISTEN
Game         16261  udp       1
Query        16261  udp       1
EOF
    exit 0

elif [ "$COMMAND" == "start" ]; then
    if [ -f "$LOCKFILE" ]; then
        echo "Server is already running."
    else
        touch "$LOCKFILE"
        echo "starting pzserver: Project Zomboid"
        sleep 1
        echo "[ OK ] Starting pzserver: Project Zomboid"
    fi
    exit 0

elif [ "$COMMAND" == "stop" ]; then
    if [ -f "$LOCKFILE" ]; then
        rm "$LOCKFILE"
        echo "stopping pzserver: Project Zomboid"
        sleep 1
        echo "[ OK ] Stopping pzserver: Project Zomboid"
    else
        echo "Server is already stopped."
        echo "[ OK ] Stopping pzserver: Project Zomboid"
    fi
    exit 0

elif [ "$COMMAND" == "restart" ]; then
    echo "restarting pzserver: Project Zomboid"
    # Iškviečiame save patį, kad sustabdytume ir paleistume
    $0 stop
    sleep 1
    $0 start
    exit 0

else
    echo "Unknown command: $COMMAND"
    echo "Usage: $0 {start|stop|restart|dt}"
    exit 1
fi