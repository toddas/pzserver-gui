    # --- Čia prasideda DINAMINĖ dalis ---
    if [ -f "$LOCKFILE" ]; then
        # Jei serveris "įjungtas" (failas yra)
        echo "LinuxGSM version:  v25.1.6"
        echo "glibc required:    2.15"
        echo "User:              pzserver"
        echo "Status: STARTED"
    else
        # Jei serveris "išjungtas" (failo nėra)
        echo "User:              pzserver"
        echo "Status: STOPPED"
    fi

    cat <<EOF

