#!/bin/bash

# Naudojame laikiną failą, kad imituotume veikiantį serverį
LOCKFILE="/tmp/pzserver.lock"
COMMAND=$1

if [ "$COMMAND" == "dt" ] || [ "$COMMAND" == "details" ]; then
    # --- Išsaugome senąjį detalų funkcionalumą ---
    cat <<EOF
